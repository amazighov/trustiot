# World Mobile Chain RPC. Keep the endpoint configurable so deployments can
# use their own provider and switch between mainnet and testnet safely.
WMC_RPC_URL=https://worldmobilechain-mainnet.g.alchemy.com/public
WMC_CHAIN_ID=869
WMC_CHAIN_NAME=World Mobile Chain

# Addresses produced when the two contracts in wmc/contracts are deployed.
WMC_DEVICE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
WMC_TELEMETRY_COMMITMENTS_ADDRESS=0x0000000000000000000000000000000000000000

# Write commands only. Supply this through the process environment and never
# commit a real private key.
WMC_PRIVATE_KEY=
WMC_CONFIRMATIONS=1
