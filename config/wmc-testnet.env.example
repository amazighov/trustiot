# World Mobile Chain public testnet (verified by eth_chainId).
WMC_RPC_URL=https://worldmobile-testnet.g.alchemy.com/public
WMC_CHAIN_ID=323432
WMC_CHAIN_NAME=World Mobile Chain Testnet
WMC_EXPLORER_URL=https://testnet-explorer.worldmobile.net
WMC_CONFIRMATIONS=1

# Use a dedicated, low-value test wallet. Never reuse a production wallet.
WMC_DEPLOYER_ADDRESS=0xYOUR_TEST_WALLET_ADDRESS

# Deliberately no WMC_PRIVATE_KEY here. This project is inside OneDrive.
# Pass the test-wallet key through the process environment for one session.

# Explicit safety latch required by the deployment command.
WMC_DEPLOY_CONFIRM=WMC_TESTNET_323432

# Fill these after deployment. They are not needed for the network check.
WMC_DEVICE_REGISTRY_ADDRESS=
WMC_TELEMETRY_COMMITMENTS_ADDRESS=

# Safe receiver defaults. Use the secure WMC launcher to override AUTO_WMC.
TRUSTIOT_AUTO_SYNAPSE_FABRIC=false
TRUSTIOT_AUTO_WMC=false
DEVICE_ESP32_01_PUBLIC_KEY_PATH=data/device-keys/esp32-01-public.pem
